# ── Base de datos ──────────────────────────────────────────────────────────────
# PostgreSQL (Docker local / producción)
DATABASE_URL="postgresql://crm_user:crm_pass_2024@localhost:5432/llamadas_crm"

# SQLite (desarrollo sin Docker — ya no recomendado)
# DATABASE_URL="file:./dev.db"

# ── Autenticación ──────────────────────────────────────────────────────────────
# ⚠ Cambia este valor por una cadena aleatoria larga en producción
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia_este_secreto_por_uno_seguro_aleatorio_2024"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development   # production en producción

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL completa del frontend en producción (ej: https://llamadas.onrender.com)
FRONTEND_URL=http://localhost:5173

# ── SMTP corporativo (formulario /contacto) ───────────────────────────────────
# Si SMTP_HOST, SMTP_USER o SMTP_PASS están vacíos, POST /api/contact responde 503
# y el frontend usa mailto + portapapeles como respaldo.
#
# Pide a IT/hosting: host SMTP, puerto, usuario, contraseña y dirección remitente permitida.
#
# ── Corporativo genérico / cPanel / hosting compartido ──
#   SMTP_HOST=mail.tudominio.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=ventas@tudominio.com
#   SMTP_PASS=tu_contraseña
#   MAIL_FROM="Optick Cloud <ventas@tudominio.com>"
#
# ── Microsoft 365 / Outlook ──
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=ventas@tudominio.com
#   SMTP_PASS=tu_contraseña_o_app_password
#   MAIL_FROM="Optick Cloud <ventas@tudominio.com>"
#
# ── Puerto 465 (SSL implícito) ──
#   SMTP_HOST=mail.tudominio.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=ventas@tudominio.com
#   SMTP_PASS=tu_contraseña
#   MAIL_FROM="Optick Cloud <ventas@tudominio.com>"
#
# ── Gmail (opción secundaria; requiere App Password) ──
#   https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   MAIL_FROM="Optick Cloud <tu@gmail.com>"
SMTP_HOST=mail.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ventas@tudominio.com
SMTP_PASS=
MAIL_FROM="Optick Cloud <ventas@tudominio.com>"

# Destinatarios del formulario (opcional; por defecto johanvidal1@gmail.com)
CONTACT_TO_SUPPORT=
CONTACT_TO_SALES=
