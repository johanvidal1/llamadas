# ── Base de datos ──────────────────────────────────────────────────────────────
# PostgreSQL (Docker local / producción)
DATABASE_URL="postgresql://crm_user:crm_pass_2024@localhost:5432/llamadas_crm"

# SQLite (desarrollo sin Docker — ya no recomendado)
# DATABASE_URL="file:./dev.db"

# ── Autenticación ──────────────────────────────────────────────────────────────
# ⚠ Cambia este valor por una cadena aleatoria larga en producción
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia_este_secreto_por_uno_seguro_aleatorio_2024"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development   # production en producción

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL completa del frontend en producción (ej: https://llamadas.onrender.com)
FRONTEND_URL=http://localhost:5173
