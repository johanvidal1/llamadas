// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role values: ADMIN | AGENT
// Disposition values: INTERESTED | NOT_INTERESTED | NO_ANSWER | BUSY | CALLBACK | DO_NOT_CALL | OTHER
// CompanyStatus values: PENDING | IN_PROGRESS | INTERESTED | CONVERTED | NOT_INTERESTED | DO_NOT_CALL
// ContactStatus values: same as CompanyStatus
// ImportStatus values: OK | NO_ENCONTRADO | SIN_CONTACTOS
// AssignmentRunStatus values: ACTIVE | PARTIALLY_RELEASED | PAUSED | CLOSED

enum AssignmentRunStatus {
  ACTIVE
  PARTIALLY_RELEASED
  PAUSED
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role          String   @default("AGENT")
  isSuperAdmin  Boolean  @default(false)
  isSystemOwner Boolean  @default(false)
  active        Boolean  @default(true)
  tokenVersion  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports              ImportBatch[]
  assignments          Assignment[]
  assignmentRunsAsAgent AssignmentRun[] @relation("AssignmentRunAgent")
  assignmentRunsAssigned AssignmentRun[] @relation("AssignmentRunAssignedBy")
  callLogs             CallLog[]
  callbacks   Callback[]
  sessions    UserSession[]
  assignmentReleases AssignmentRelease[] @relation("AssignmentReleaseBy")
  dailyAgentMetrics    DailyAgentMetrics[]
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  deviceLabel  String?
  ipAddress    String?
  userAgent    String?
  browser      String?
  os           String?
  platform     String?
  currentRoute String?
  loginAt      DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([lastSeenAt])
  @@index([userId])
}

model ImportBatch {
  id              String    @id @default(cuid())
  filename        String
  displayName     String?
  fileSizeBytes   Int?
  sourceRowCount  Int?
  storagePath     String?
  totalRecords    Int
  blocked         Boolean   @default(false)
  importedById    String
  importedBy    User      @relation(fields: [importedById], references: [id])
  createdAt     DateTime  @default(now())

  companies      Company[]
  mobileLines    MobileLine[]
  assignmentRuns AssignmentRun[]
}

model Company {
  id            String      @id @default(cuid())
  ruc           String
  razonSocial   String?
  importStatus  String?
  fechaConsulta DateTime?
  plan          String?
  notes         String?
  status        String      @default("PENDING")
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contacts    Contact[]
  callLogs    CallLog[]
  callbacks   Callback[]
  mobileLines MobileLine[]
}

model MobileLine {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruc            String
  numeroTelefono String?
  estadoLinea    String?
  plan           String?
  estado         String?
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([companyId])
  @@index([importBatchId])
}

model Contact {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nombre       String
  tipoContacto String?
  dni          String?
  email        String?
  telefono     String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  assignment Assignment?
  callLogs   CallLog[]
}

model AssignmentRun {
  id            String              @id @default(cuid())
  agentId       String
  agent         User                @relation("AssignmentRunAgent", fields: [agentId], references: [id])
  importBatchId String?
  importBatch   ImportBatch?        @relation(fields: [importBatchId], references: [id])
  assignedById  String
  assignedBy    User                @relation("AssignmentRunAssignedBy", fields: [assignedById], references: [id])
  companyCount  Int
  contactCount  Int
  status        AssignmentRunStatus @default(ACTIVE)
  releasedAt    DateTime?
  releaseNote   String?
  createdAt     DateTime            @default(now())
  assignments   Assignment[]
  releases      AssignmentRelease[]

  @@index([agentId, createdAt])
  @@index([importBatchId])
}

model AssignmentRelease {
  id              String         @id @default(cuid())
  assignmentRunId String?
  assignmentRun   AssignmentRun? @relation(fields: [assignmentRunId], references: [id])
  releasedById    String
  releasedBy      User           @relation("AssignmentReleaseBy", fields: [releasedById], references: [id])
  agentId         String
  importBatchId   String?
  companyCount    Int
  contactCount    Int
  reason          String?
  createdAt       DateTime       @default(now())

  @@index([assignmentRunId])
  @@index([agentId, createdAt])
}

model Assignment {
  id              String         @id @default(cuid())
  contactId       String         @unique
  contact         Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agentId         String
  agent           User           @relation(fields: [agentId], references: [id])
  assignmentRunId String?
  assignmentRun   AssignmentRun? @relation(fields: [assignmentRunId], references: [id])
  assignedAt      DateTime       @default(now())
}

model CallLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  agentId     String
  agent       User     @relation(fields: [agentId], references: [id])
  disposition String
  aclaracion  String?
  notes       String?
  calledAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  callback Callback?

  @@index([calledAt])
  @@index([agentId, calledAt])
  @@index([companyId])
  @@index([disposition])
}

model DailyAgentMetrics {
  id                   String   @id @default(cuid())
  date                 DateTime @db.Date
  agentId              String
  agent                User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  calls                Int      @default(0)
  newRegistrations     Int      @default(0)
  updatedRegistrations Int      @default(0)
  contactedCompanies   Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([date, agentId])
  @@index([date])
  @@index([agentId, date])
}

model Callback {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  agentId     String
  agent       User      @relation(fields: [agentId], references: [id])
  callLogId   String?   @unique
  callLog     CallLog?  @relation(fields: [callLogId], references: [id])
  scheduledAt DateTime
  notes       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}