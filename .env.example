# Plantilla CRM staging (/opt/llamadas) — copiar a .env y completar.
#   cp .env.example .env && chmod 600 .env
# Dominio: https://pruebacrm.optickcloud.com
# NO pegar secretos de producción. Nombres tomados del código (backend/.env.example + render.yaml).

# ── Postgres (servicio Docker "db", red internas) ─────────────────────────────
POSTGRES_USER=llamadas
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_DB=llamadas_crm
# Host "db" = nombre del servicio compose (NO localhost)
DATABASE_URL=postgresql://llamadas:CHANGE_ME_GENERATE_STRONG_PASSWORD@db:5432/llamadas_crm
# Opcional (defaults en código / prisma.ts)
# DATABASE_CONNECTION_LIMIT=5
# DATABASE_POOL_TIMEOUT=20

# ── API (Express) ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Timezone reportes (default America/Lima en código)
APP_TIMEZONE=America/Lima

# ── Auth JWT (requerido) ──────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_LONG_RANDOM_HEX

# ── CORS / frontend origin (sin barra final) ──────────────────────────────────
FRONTEND_URL=https://pruebacrm.optickcloud.com
# CORS_EXTRA_ORIGINS=

# ── Build-arg frontend (compose → Dockerfile ARG; bake en la imagen) ──────────
# Origen público SIN path /api. Mismo host que Caddy → same-origin.
VITE_API_URL=https://pruebacrm.optickcloud.com
# VITE_CSP_EXTRA_ORIGINS=

# ── Seed owner (opcional; solo si ejecutas npm run db:seed en el contenedor) ──
# SYSTEM_OWNER_EMAIL=
# SYSTEM_OWNER_PASSWORD=

# ── SMTP (opcional; sin esto POST /api/contact → 503 + fallback mailto) ───────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Optick Cloud <ventas@tudominio.com>"
# CONTACT_TO_SUPPORT=
# CONTACT_TO_SALES=
